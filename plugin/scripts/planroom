#!/bin/sh
# Planroom's engine resolver. It finds the `planroom` engine, or fetches it, then runs it with the
# arguments it was given. It locates everything from its own path, never from a plugin variable,
# since the Bash tool sets none. See docs/contributing/architecture.md, "Packaging and release".
#
#   planroom ARGS...       resolve the engine and run it with ARGS
#   planroom status --json the step that resolves the engine and its path, without fetching
#   planroom build         build the engine from source
#
# Environment (a contract, docs/contributing/contracts.md, "The resolver's environment"):
#   PLANROOM_ENGINE            a binary to use as it is
#   PLANROOM_RESOLVE           auto (default), checkout or release
#   PLANROOM_RELEASE_BASE_URL  where releases come from: https, or plain http to a loopback host
#   PLANROOM_DATA              the data root
set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
self="$here/planroom"
data="${PLANROOM_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/planroom}"

version=''
catalogue=''
repo=''
while IFS='=' read -r key value; do
  case $key in
    PLANROOM_ENGINE_VERSION) version=$value ;;
    PLANROOM_CATALOGUE_HASH) catalogue=$value ;;
    PLANROOM_REPO) repo=$value ;;
  esac
done <"$here/engine.env"

json=no
for arg in "$@"; do
  if [ "$arg" = --json ]; then
    json=yes
  fi
done
command_name=version
case ${1:-} in
  '' | *[!a-z]*) ;;
  *) command_name=$1 ;;
esac

# --- output -------------------------------------------------------------------------------------

json_string() {
  printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}

# One --json envelope for a failure: code, category, retry, message, hint, details (JSON), exit.
envelope_error() {
  body="{\"schema_version\":1,\"ok\":false,\"command\":$(json_string "$command_name"),\"error\":{\"code\":\"$1\",\"category\":\"$2\",\"retry\":\"$3\""
  if [ -n "${retry_after_ms:-}" ]; then
    body="$body,\"retry_after_ms\":$retry_after_ms"
  fi
  body="$body,\"message\":$(json_string "$4"),\"hint\":$(json_string "$5"),\"details\":$6},\"meta\":{\"seq\":0,\"took_ms\":0,\"size\":{\"bytes\":"
  # The size counts the whole document, its own digits included.
  bytes=0
  for _ in 1 2 3; do
    doc="$body$bytes,\"tokens_est\":$(((bytes + 3) / 4))}}}"
    bytes=${#doc}
  done
  printf '%s\n' "$doc"
}

# Stop with engine_unavailable: reason, message, fix, then optional extra details as JSON pairs.
unavailable() {
  details="{\"reason\":\"$1\",\"fix\":$(json_string "$3")${4:+,$4}}"
  if [ "$json" = yes ]; then
    envelope_error engine_unavailable unavailable never "$2" "$3" "$details"
  else
    printf 'planroom: %s\n  fix: %s\n' "$2" "$3" >&2
  fi
  exit 7
}

usage_error() {
  if [ "$json" = yes ]; then
    envelope_error invalid_argument usage never "$1" "$2" "{\"field\":\"PLANROOM_RESOLVE\"}"
  else
    printf 'planroom: %s\n  fix: %s\n' "$1" "$2" >&2
  fi
  exit 2
}

say() {
  printf 'planroom: %s\n' "$1" >&2
}

# --- helpers ------------------------------------------------------------------------------------

# The version an engine reports, from `planroom --version` ("planroom 0.1.0").
engine_version() {
  "$1" --version 2>/dev/null | awk 'NR == 1 { print $2 }' || true
}

# The catalogue hash an engine reports, from `planroom version --json`; empty when it reports none.
engine_catalogue() {
  "$1" version --json 2>/dev/null | sed -n 's/.*"catalogue_hash":"\([^"]*\)".*/\1/p' | head -n 1 || true
}

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{ print $1 }'
  else
    shasum -a 256 "$1" | awk '{ print $1 }'
  fi
}

is_dev() {
  case $version in *-dev) return 0 ;; esac
  return 1
}

# Whether $1 is newer than $2 (POSIX find; test -nt isn't POSIX).
newer_than() {
  [ -n "$(find "$1" -prune -newer "$2")" ]
}

target_triple() {
  case $(uname -m) in
    x86_64 | amd64) arch=x86_64 ;;
    aarch64 | arm64) arch=aarch64 ;;
    *) return 1 ;;
  esac
  case $(uname -s) in
    Linux) printf '%s-unknown-linux-musl\n' "$arch" ;;
    Darwin) printf '%s-apple-darwin\n' "$arch" ;;
    *) return 1 ;;
  esac
}

checkout_dir() {
  [ -f "$here/../../Cargo.toml" ] || return 1
  CDPATH='' cd -- "$here/../.." && pwd -P
}

cache_dir="$data/engine/$version"

touch_last_used() {
  : >"$cache_dir/last_used"
}

# Remove cached versions nobody used for 7 days; a session on an older plugin keeps its binary.
prune() {
  for dir in "$data"/engine/*/; do
    dir=${dir%/}
    if [ ! -f "$dir/last_used" ] || [ "$dir" = "$cache_dir" ]; then
      continue
    fi
    if [ -n "$(find "$dir/last_used" -mtime +7)" ]; then
      rm -rf "$dir"
    fi
  done
}

# --- the fetch lock -----------------------------------------------------------------------------

lock="$data/engine/.lock"

lock_is_stale() {
  owner=$(cat "$lock/owner" 2>/dev/null || true)
  if [ -z "$owner" ]; then
    # Taken a moment ago and not yet stamped, or left by a crash: stale after 15 minutes.
    [ -n "$(find "$lock" -prune -mmin +15)" ]
    return
  fi
  pid=${owner%% *}
  at=${owner#* }
  ! kill -0 "$pid" 2>/dev/null || [ $(($(date +%s) - at)) -gt 900 ]
}

take_lock() {
  if ! mkdir -p "$data/engine"; then
    unavailable download_failed "Couldn't make $data/engine." "check the permissions of $data"
  fi
  waited=0
  while ! mkdir "$lock" 2>/dev/null; do
    if lock_is_stale; then
      rm -rf "$lock"
      continue
    fi
    if [ "$waited" -ge 20 ]; then
      retry_after_ms=5000
      message="Another session is fetching the Planroom engine."
      if [ "$json" = yes ]; then
        envelope_error engine_fetching unavailable later "$message" "try again in a few seconds" \
          '{"progress":"another process holds the fetch lock"}'
      else
        say "$message Try again in a few seconds."
      fi
      exit 7
    fi
    sleep 1
    waited=$((waited + 1))
  done
  printf '%s %s\n' "$$" "$(date +%s)" >"$lock/owner"
  trap 'rm -rf "$lock" ${tmp:+"$tmp"}' EXIT
  trap 'exit 130' INT TERM
}

drop_lock() {
  rm -rf "$lock" ${tmp:+"$tmp"}
  tmp=''
  trap - EXIT INT TERM
}

# --- download -----------------------------------------------------------------------------------

release_base() {
  base=${PLANROOM_RELEASE_BASE_URL:-https://github.com/$repo/releases/download}
  case $base in
    *@*) return 1 ;;
    https://*) loopback=no ;;
    http://127.0.0.1 | http://127.0.0.1[:/]* | http://localhost | http://localhost[:/]*) loopback=yes ;;
    'http://[::1]' | 'http://[::1]'[:/]*) loopback=yes ;;
    *) return 1 ;;
  esac
  base=${base%/}
}

fetch() {
  if command -v curl >/dev/null 2>&1; then
    if [ "$loopback" = yes ]; then
      curl -fsSL --noproxy '*' --proto '=http' --proto-redir '=http' -o "$2" "$1"
    else
      curl -fsSL --proto '=https' --proto-redir '=https' -o "$2" "$1"
    fi
  elif command -v wget >/dev/null 2>&1; then
    if [ "$loopback" = yes ]; then
      wget -q --no-proxy -O "$2" "$1"
    else
      wget -q -O "$2" "$1"
    fi
  else
    say "neither curl nor wget is installed"
    return 1
  fi
}

# Download, verify and install the release into the cache. Returns non-zero with $why set.
download() {
  if ! release_base; then
    unavailable download_failed \
      "PLANROOM_RELEASE_BASE_URL must use https, or plain http only to 127.0.0.1, localhost or ::1." \
      "unset PLANROOM_RELEASE_BASE_URL"
  fi
  if ! triple=$(target_triple); then
    why="Planroom has no engine release for $(uname -s) $(uname -m)."
    return 1
  fi
  take_lock
  # Another process may have installed it while this one waited.
  if [ -x "$cache_dir/planroom" ] && [ -s "$cache_dir/.ok" ]; then
    drop_lock
    return 0
  fi
  if ! tmp=$(mktemp -d "$data/engine/.fetch.XXXXXX"); then
    drop_lock
    why="Couldn't make a directory under $data/engine."
    return 1
  fi
  archive="planroom-v$version-$triple.tar.gz"
  url="$base/v$version"
  say "fetching the Planroom engine $version for $triple"
  if ! fetch "$url/SHA256SUMS" "$tmp/SHA256SUMS" || ! fetch "$url/$archive" "$tmp/$archive"; then
    drop_lock
    why="Couldn't download $url/$archive."
    return 1
  fi
  want=$(awk -v f="$archive" '$2 == f || $2 == "*" f { print $1; exit }' "$tmp/SHA256SUMS")
  got=$(sha256_of "$tmp/$archive")
  if [ -z "$want" ] || [ "$want" != "$got" ]; then
    drop_lock
    why="The download of $archive doesn't match its SHA256SUMS entry, so it was discarded."
    return 1
  fi
  if ! mkdir "$tmp/x" || ! tar -xzf "$tmp/$archive" -C "$tmp/x"; then
    drop_lock
    why="Couldn't unpack $archive."
    return 1
  fi
  bin=''
  for candidate in "$tmp/x/planroom" "$tmp/x"/*/planroom; do
    if [ -f "$candidate" ] && [ ! -h "$candidate" ]; then
      bin=$candidate
      break
    fi
  done
  if [ -z "$bin" ]; then
    drop_lock
    why="$archive holds no planroom binary."
    return 1
  fi
  # `download` runs as an `if` condition, where `set -e` is off, so each step is checked.
  if ! { chmod 755 "$bin" && mkdir -p "$cache_dir" && rm -f "$cache_dir/.ok" \
    && mv -f "$bin" "$cache_dir/planroom" && sha256_of "$cache_dir/planroom" >"$cache_dir/.ok.new" \
    && mv -f "$cache_dir/.ok.new" "$cache_dir/.ok" && touch_last_used; }; then
    drop_lock
    why="Couldn't install the engine into $cache_dir."
    return 1
  fi
  drop_lock
  prune
  return 0
}

# --- the source build ---------------------------------------------------------------------------

# Check what a source build needs. Prints extra details JSON; returns 1 with $fix set when a tool
# is missing.
build_preflight() {
  if ! command -v cargo >/dev/null 2>&1; then
    fix="Install Rust with rustup: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"
    missing=cargo
    return 1
  fi
  if ! command -v rustup >/dev/null 2>&1 && checkout=$(checkout_dir); then
    want=$(awk -F'"' '/^rust-version/ { print $2; exit }' "$checkout/Cargo.toml")
    have=$(cd / && cargo --version | awk '{ print $2 }')
    if [ -n "$want" ] && ! printf '%s\n%s\n' "$want" "$have" | awk -F. '
      NR == 1 { w1 = $1; w2 = $2 } NR == 2 { exit !($1 > w1 || ($1 == w1 && $2 >= w2)) }'; then
      fix="Rust $want or later is needed (found $have): rustup update, or install rustup"
      missing=cargo
      return 1
    fi
  fi
  if ! command -v cc >/dev/null 2>&1 && ! command -v gcc >/dev/null 2>&1 \
    && ! command -v clang >/dev/null 2>&1; then
    case $(uname -s) in
      Darwin) fix="xcode-select --install" ;;
      *) fix="Install a C compiler, such as: sudo apt-get install build-essential" ;;
    esac
    missing=cc
    return 1
  fi
  canvas=true
  if ! command -v node >/dev/null 2>&1 || ! command -v pnpm >/dev/null 2>&1; then
    canvas=false
  fi
  return 0
}

# No engine could be resolved: name the source build, or the missing tool.
offer_build() {
  if build_preflight; then
    unavailable "$1" "$2 Build it from source, about 4 minutes: $self build" "$self build" \
      "\"est_minutes\":4,\"canvas\":$canvas"
  fi
  unavailable no_toolchain "$2 Building it from source needs $missing. $fix" "$fix" \
    "\"missing\":\"$missing\""
}

build() {
  if checkout=$(checkout_dir); then
    say "building the engine in $checkout"
    (cd "$checkout" && cargo build --release --locked -p planroom) >&2
    exit $?
  fi
  src="$data/src/$version"
  ref="v$version"
  if is_dev; then
    ref=main
  elif ! git ls-remote --exit-code --tags "https://github.com/$repo" "refs/tags/$ref" >/dev/null 2>&1; then
    say "the tag $ref isn't published yet, so this builds from main"
    ref=main
  fi
  rm -rf "$src"
  mkdir -p "$data/src"
  git -c core.hooksPath=/dev/null clone --quiet --depth 1 --branch "$ref" \
    "https://github.com/$repo" "$src" >&2
  (cd "$src" && cargo build --release --locked -p planroom) >&2
  built="$src/target/release/planroom"
  if [ "$(engine_version "$built")" != "$version" ]; then
    say "This plugin is older than main. Update it: /plugin marketplace update planroom"
    exit 7
  fi
  mkdir -p "$cache_dir"
  cp "$built" "$cache_dir/planroom.new"
  mv -f "$cache_dir/planroom.new" "$cache_dir/planroom"
  sha256_of "$cache_dir/planroom" >"$cache_dir/.ok"
  touch_last_used
  exit 0
}

# --- resolution ---------------------------------------------------------------------------------

# Sets $engine and $step, or stops with an envelope. With $1 = no, it never downloads: it returns 1
# with $step = download when the next run would fetch the engine.
resolve() {
  if [ -n "${PLANROOM_ENGINE:-}" ]; then
    if [ -f "$PLANROOM_ENGINE" ] && [ -x "$PLANROOM_ENGINE" ]; then
      engine=$PLANROOM_ENGINE
      step=override
      return 0
    fi
    unavailable override_missing "PLANROOM_ENGINE names $PLANROOM_ENGINE, which isn't an executable file." \
      "unset PLANROOM_ENGINE"
  fi

  mode=${PLANROOM_RESOLVE:-auto}
  case $mode in
    auto | checkout | release) ;;
    *) usage_error "PLANROOM_RESOLVE is $mode; it must be auto, checkout or release." "unset PLANROOM_RESOLVE" ;;
  esac

  if [ "$mode" != release ] && checkout=$(checkout_dir); then
    best=''
    stale=''
    for candidate in "$checkout/target/release/planroom" "$checkout/target/debug/planroom"; do
      [ -f "$candidate" ] || continue
      [ -x "$candidate" ] || continue
      if [ -n "$catalogue" ] && [ "$(engine_catalogue "$candidate")" = "$catalogue" ]; then
        if [ -z "$best" ] || newer_than "$candidate" "$best"; then
          best=$candidate
        fi
      else
        stale=$candidate
      fi
    done
    if [ -n "$best" ]; then
      engine=$best
      step=checkout
      return 0
    fi
    if [ -n "$stale" ]; then
      unavailable stale_build "The engine built in $checkout doesn't serve this plugin's command catalogue." \
        "cd $checkout && cargo build -p planroom"
    fi
  fi

  if [ "$mode" = checkout ]; then
    offer_build no_build "No engine is built in this checkout."
  fi

  if [ -x "$cache_dir/planroom" ] && [ -s "$cache_dir/.ok" ]; then
    engine="$cache_dir/planroom"
    step=cache
    touch_last_used
    return 0
  fi

  if is_dev && [ -z "${PLANROOM_RELEASE_BASE_URL:-}" ]; then
    offer_build no_release "Planroom $version is a development version, so it has no engine release."
  fi
  if [ "$1" = no ]; then
    step=download
    return 1
  fi
  why=''
  if download; then
    engine="$cache_dir/planroom"
    step=download
    return 0
  fi
  offer_build download_failed "$why"
}

case ${1:-} in
  status)
    if ! resolve no; then
      if [ "$json" = yes ]; then
        printf '{"ok":false,"step":"download","version":%s}\n' "$(json_string "$version")"
      else
        printf 'download %s\n' "$version"
      fi
      exit 1
    fi
    if [ "$json" = yes ]; then
      printf '{"ok":true,"step":"%s","path":%s,"version":%s}\n' \
        "$step" "$(json_string "$engine")" "$(json_string "$version")"
    else
      printf '%s %s\n' "$step" "$engine"
    fi
    exit 0
    ;;
  build) build ;;
esac

resolve yes
exec "$engine" "$@"
