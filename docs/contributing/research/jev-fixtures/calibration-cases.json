    "mismatch_class": {
      "type": "choice",
      "question": {
        "type": "choice",
        "instructions": "Classify this difference between the plan (`intent`) and the code (`actual`).",
        "criteria": {
          "expected": "The plan item is scheduled but not started, and nothing in reality has moved toward it yet. Nothing is wrong.",
          "in_progress": "Work toward the plan item has started (commits, branch, partial code) but it is not finished.",
          "done": "Reality now satisfies the plan item and its done-test; the item can be closed.",
          "unplanned": "Reality contains a change that no plan item asked for.",
          "regression": "Something that used to satisfy a plan item no longer does."
        }
      },
      "cases": [
        {
          "id": "ep1",
          "label": "done",
          "state": {
            "intent": {
              "id": "P-3",
              "says": "Add `planroom scan --json`",
              "done_test": "scan_json snapshot test passes",
              "status": "in progress"
            },
            "actual": {
              "before": "no --json flag",
              "now": "--json flag exists; scan_json snapshot test passes in CI"
            }
          }
        },
        {
          "id": "ep2",
          "label": "regression",
          "state": {
            "intent": {
              "id": "P-1",
              "says": "Canvas loads in under 1 s",
              "status": "done"
            },
            "actual": {
              "before": "load 0.6 s, test green",
              "now": "load 2.4 s after commit 9f2c; perf test red"
            }
          }
        },
        {
          "id": "ep3",
          "label": "unplanned",
          "state": {
            "intent": null,
            "actual": {
              "before": "no telemetry",
              "now": "new crate planroom-telemetry added in commit 77ab; no plan item mentions telemetry"
