    "commit_addresses_thread": {
      "type": "boolean",
      "question": {
        "type": "boolean",
        "instructions": "Does `commit` address the concern raised in `thread`?",
        "criteria": {
          "true": "The commit changes the code the thread is about in the way the reviewer asked, or fixes the problem they raised.",
          "false": "The commit touches other code, or touches the same file without fixing the raised concern."
        }
      },
      "cases": [
        {
          "id": "ep1",
          "label": true,
          "state": {
            "thread": {
              "file": "crates/planroom-decide/src/jev.rs",
              "line": 52,
              "comment": "This unwrap() will panic on a 429. Please return an error instead."
            },
            "commit": {
              "message": "decide: return JevError::RateLimited on 429 instead of panicking",
              "diff": "jev.rs: -let body = resp.json().unwrap(); +if resp.status() == 429 { return Err(JevError::RateLimited { retry_after }) }"
            }
          }
        },
        {
          "id": "ep2",
          "label": true,
          "state": {
            "thread": {
              "file": "web/canvas/src/DecisionCard.tsx",
              "line": 30,
              "comment": "Buttons are 32px; tap targets must be at least 44px."
            },
            "commit": {
              "message": "canvas: make decision card buttons 48px",
              "diff": "DecisionCard.tsx: -height: 32px +height: 48px"
            }
          }
        },
        {
          "id": "ep3",
          "label": true,
          "state": {
            "thread": {
              "file": "crates/planroom-store/src/lib.rs",
              "line": 10,
              "comment": "Please enable WAL mode when opening the database."
            },
            "commit": {
              "message": "store: open SQLite in WAL mode",
              "diff": "lib.rs: +conn.pragma_update(None, \"journal_mode\", \"WAL\")?;"
            }
          }
        },
        {
          "id": "ep4",
          "label": true,
          "state": {
            "thread": {
              "file": "README.md",
              "line": 3,
              "comment": "Typo: 'Planrom' should be 'Planroom'."
            },
            "commit": {
              "message": "docs: fix product name typo",
              "diff": "README.md: -Planrom +Planroom"
            }
          }
        },
        {
          "id": "ep5",
          "label": true,
          "state": {
            "thread": {
              "file": "crates/planroom-cli/src/main.rs",
              "line": 77,
              "comment": "Missing test for the --json flag on `scan`."
            },
            "commit": {
              "message": "cli: add snapshot test for scan --json",
              "diff": "tests/scan_json.rs: new file, 40 lines, insta::assert_json_snapshot!(out)"
            }
          }
        },
        {
          "id": "en1",
