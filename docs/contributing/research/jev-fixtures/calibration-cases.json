    "dependency_real": {
      "type": "boolean",
      "question": {
        "type": "boolean",
        "instructions": "Does the evidence show that component `edge.from` really depends on component `edge.to` at build time or run time?",
        "criteria": {
          "true": "The evidence shows `from` imports, calls, links to, or sends requests to `to`.",
          "false": "The evidence is only a name match, a comment, documentation, or test-only use, or it shows the reverse direction."
        }
      },
      "cases": [
        {
          "id": "ep1",
          "label": true,
          "state": {
            "edge": {
              "from": "planroom-cli",
              "to": "planroom-store"
            },
            "evidence": [
              "crates/planroom-cli/Cargo.toml: planroom-store = { path = \"../planroom-store\" }",
              "crates/planroom-cli/src/main.rs:14: let store = planroom_store::Store::open(&path)?;"
            ]
