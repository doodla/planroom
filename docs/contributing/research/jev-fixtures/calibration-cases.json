{
  "note": "Spike cases for Planroom decision kinds. Labels are the spike author's, written before any call. They are development cases, NOT the independent held-out set S7 requires. Model: typesafe-ai/jev-1.14.0 via /v1/evaluate, one question named 'q' per request.",
  "buckets": {
    "ep": "easy positive (for choice kinds: easy, clear answer)",
    "en": "easy negative (for choice kinds: easy, clear answer)",
    "am": "ambiguous"
  },
  "kinds": {
    "next_action_concrete": {
      "type": "boolean",
      "question": {
        "type": "boolean",
        "instructions": "Is `next_action` concrete? Concrete means it has all three: an action verb, a named target component or file, and a done-test (a command, check, or observable result that shows it is finished).",
        "criteria": {
          "true": "All three are present: verb, named target, and done-test.",
          "false": "At least one of the three is missing or only implied."
        }
      },
      "cases": [
        {
          "id": "ep1",
          "label": true,
          "state": {
            "next_action": "Add a `decision_cache` table to planroom-store; done when `cargo test -p planroom-store cache_roundtrip` passes."
          }
        },
        {
          "id": "ep2",
          "label": true,
          "state": {
            "next_action": "Rename `Edge::kind` to `Edge::relation` in crates/planroom-kernel/src/edge.rs; done when `cargo check --workspace` is clean."
          }
        },
        {
          "id": "ep3",
          "label": true,
          "state": {
            "next_action": "Write a Playwright test in web/canvas/e2e/zoom.spec.ts that pinches to zoom at 390x844; done when it passes in CI."
          }
        },
        {
          "id": "ep4",
          "label": true,
          "state": {
            "next_action": "Make `planroom scan --json` emit a `stats.files` count; done when the snapshot test `scan_json_stats` matches the new output."
          }
        },
        {
          "id": "ep5",
          "label": true,
          "state": {
            "next_action": "Delete the unused `legacy_layout` module from planroom-server; done when `cargo clippy -- -D warnings` passes with no dead-code warnings."
          }
        },
        {
          "id": "en1",
          "label": false,
          "state": {
            "next_action": "Think about performance."
          }
        },
        {
          "id": "en2",
          "label": false,
          "state": {
            "next_action": "Make the app better."
          }
        },
        {
          "id": "en3",
          "label": false,
          "state": {
            "next_action": "Look into the flaky stuff people mentioned."
          }
        },
        {
          "id": "en4",
          "label": false,
          "state": {
            "next_action": "Improve things where needed."
          }
        },
        {
          "id": "en5",
          "label": false,
          "state": {
            "next_action": "Keep going on the plan."
          }
        },
        {
          "id": "am1",
          "label": false,
          "state": {
            "next_action": "Refactor the store module to use prepared statements."
          }
        },
        {
          "id": "am2",
          "label": false,
          "state": {
            "next_action": "Make sure all the tests pass before Friday."
          }
        },
        {
          "id": "am3",
          "label": true,
          "state": {
            "next_action": "Add caching to planroom-decide so rescans get faster; check the rescan benchmark afterwards."
          }
        },
        {
          "id": "am4",
          "label": false,
