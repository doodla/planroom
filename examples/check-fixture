# 3. evidence: every item's substring is on exactly its "line"
def walk(x, where="$", svc=None):
    if isinstance(x, dict):
        if "from" in x and "to" in x:
            svc = x["to"] if x.get("kind") == "deploys" else x["from"]
        elif isinstance(x.get("name"), str) and "declared_in" in x:
            svc = x["name"]
        if "path" in x and "contains" in x:
            yield where, x, svc
        for k, v in x.items():
            yield from walk(v, f"{where}.{k}", svc)
    elif isinstance(x, list):
        for i, v in enumerate(x):
            yield from walk(v, f"{where}[{i}]", svc)


STATE_DIRS = {"post_handoff": H, "post_merges": M}


def file_text(e, head=False):
    path = e["path"]
    if path.startswith("examples/"):
        return (EX.parent / path).read_text()
    repo, rel = path.split("/", 1)
    if e.get("at"):
        f = STATE_DIRS[e["at"]] / repo / rel
        return f.read_text() if f.exists() else None
    ref = e.get("branch") or "main"
    if e.get("commit_subject") and not head:
        shas = git(a / repo, "log", ref, "--format=%H", "-F", f"--grep={e['commit_subject']}").stdout.split()
        if len(shas) != 1:
            return None
        ref = shas[0]
    r = git(a / repo, "show", f"{ref}:{rel}", check=False)
    return None if r.returncode else r.stdout


