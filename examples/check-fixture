def tests_at(when):
    sha = git(a / "worker", "rev-list", "-1", f"--before={when}", "main").stdout.strip()
    files = [f for f in git(a / "worker", "ls-tree", "-r", "--name-only", sha, "tests").stdout.split() if f.endswith(".py")]
    return sum(len(re.findall(r"^def test_", git(a / "worker", "show", f"{sha}:{f}").stdout, re.M)) for f in files)


for run in runs:
    if run["repo"] != "worker":
        continue
    base = tests_at(run["started_at"])
    edits_tests = any(s["kind"] == "edit" and s["path"].startswith("tests/") for s in run["steps"])
    totals = []
    for s in run["steps"]:
        if s.get("command", "").endswith("pytest -q"):
            m = re.search(r"(\d+) passed(?:, (\d+) errors)?", s["output_excerpt"])
            totals.append(int(m.group(1)) + int(m.group(2) or 0))
    if edits_tests:
        msg = f"{run['run_id']}: {base} tests at start, run adds tests; pytest totals {totals}"
        if len(set(totals)) == 1 and totals[0] > base:
            ok(True, msg)
        else:
            print("WARN " + msg + " (not consistent; outside this revision's decisions)")
    else:
        ok(set(totals) == {base}, f"{run['run_id']}: {base} tests existed at {run['started_at']}; pytest totals {totals}")

# components exist on main
missing = []
for c in truth["components"]:
    repo, rel = c["path"].split("/", 1)
    if git(a / repo, "cat-file", "-e", f"main:{rel}", check=False).returncode:
        missing.append(c["path"])
ok(not missing, f"{len(truth['components'])} components exist on main {missing}")

print(f"\n{len(fails)} failures")
if "--keep" not in sys.argv:
    shutil.rmtree(SCR, ignore_errors=True)
sys.exit(1 if fails else 0)
