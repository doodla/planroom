def compose_service_at(lines, idx):
    in_services, svc = False, None
    for l in lines[: idx + 1]:
        if re.match(r"^\S", l):
            in_services, svc = l.startswith("services:"), None
        elif in_services and re.match(r"^  ([a-z][a-z0-9-]*):\s*$", l):
            svc = re.match(r"^  ([a-z][a-z0-9-]*):", l).group(1)
    return svc if in_services else None


def service_lines(text, svc):
    lines = text.split("\n")
    return [l for i, l in enumerate(lines) if compose_service_at(lines, i) == svc]


