for where, e, svc in walk(truth):
    n += 1
    t = file_text(e)
    lines = t.split("\n") if t is not None else []
    ln = e.get("line")
    if not isinstance(ln, int) or not (1 <= ln <= len(lines)) or e["contains"] not in lines[ln - 1]:
        bad.append(f"{where}: {e['path']}@{e.get('at') or e.get('commit_subject') or e.get('branch', 'main')}:{ln} lacks {e['contains']!r}")
        continue
    if sum(e["contains"] in l for l in lines) > 1:
        multi += 1
    if "head_line" in e:
        hl = file_text(e, head=True).split("\n")
        if e["contains"] not in hl[e["head_line"] - 1]:
            bad.append(f"{where}: head_line {e['head_line']} lacks {e['contains']!r}")
    if e["path"].endswith("docker-compose.yml") and svc in {"storefront", "orders", "worker"} and "image:" not in e["contains"]:
