diff --git a/worker/orders_client.py b/worker/orders_client.py
new file mode 100644
index 0000000..2ab9ecc
--- /dev/null
+++ b/worker/orders_client.py
@@ -0,0 +1,57 @@
+"""Client for the orders API, which the worker reports fulfilment through.
+
+The worker does not touch orders-db. State changes go through
+POST /orders/{id}/events (see orders/api/openapi.yaml), so the orders
+service enforces the lifecycle and its guards.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import urllib.error
+import urllib.parse
+import urllib.request
+from typing import Any
+
+DEFAULT_TIMEOUT_SECONDS = 5.0
+
+
+class OrdersApiError(Exception):
+    """The orders API answered with an error status."""
+
+    def __init__(self, status: int, detail: str) -> None:
+        super().__init__(f"orders API returned {status}: {detail}")
+        self.status = status
+        self.detail = detail
+
+
+class OrdersClient:
+    def __init__(self, base_url: str | None = None, timeout: float = DEFAULT_TIMEOUT_SECONDS) -> None:
+        base_url = base_url or os.environ.get("ORDERS_URL")
+        if not base_url:
+            raise RuntimeError("ORDERS_URL is not set")
+        self._base = base_url.rstrip("/")
+        self._timeout = timeout
+
+    def get_order(self, order_id: str) -> dict[str, Any]:
+        """GET /orders/{id}"""
+        return self._request("GET", f"/orders/{urllib.parse.quote(order_id)}")
+
+    def apply_event(self, order_id: str, event: str, **fields: str) -> dict[str, Any]:
+        """POST /orders/{id}/events and return the order after the event."""
+        body = {"event": event, **fields}
+        return self._request("POST", f"/orders/{urllib.parse.quote(order_id)}/events", body)
+
+    def _request(self, method: str, path: str, body: dict[str, Any] | None = None) -> dict[str, Any]:
+        headers = {"Accept": "application/json"}
+        data = None
+        if body is not None:
+            data = json.dumps(body).encode("utf-8")
+            headers["Content-Type"] = "application/json"
+        req = urllib.request.Request(self._base + path, data=data, method=method, headers=headers)
+        try:
+            with urllib.request.urlopen(req, timeout=self._timeout) as res:
+                return json.load(res)
+        except urllib.error.HTTPError as e:
+            raise OrdersApiError(e.code, e.read().decode("utf-8", "replace")) from None
