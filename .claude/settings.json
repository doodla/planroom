{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/guardrails/runner.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/guardrails/runner.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "claudeMdExcludes": [
    "**/examples/fixture/**/CLAUDE.md",
    "**/target/**/CLAUDE.md"
  ],
  "permissions": {
    "deny": [
      "Skill(run-worker-tests)"
    ]
  }
}
